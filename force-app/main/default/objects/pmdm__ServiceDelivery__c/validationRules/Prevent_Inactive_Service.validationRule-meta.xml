<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Inactive_Service</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK( pmdm__Service__c )),
  NOT( pmdm__Service__r.Active__c )
)</errorConditionFormula>
    <errorMessage>You cannot select an inactive Service</errorMessage>
</ValidationRule>
