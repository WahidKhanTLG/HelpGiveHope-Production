<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Gender_When_Bedding</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  ISPICKVAL( pmdm__Service__r.Category__c , &quot;Bedding&quot;),
  ISBLANK(TEXT(Gender__c))
)</errorConditionFormula>
    <errorMessage>Please select Gender for Bedding items</errorMessage>
</ValidationRule>
