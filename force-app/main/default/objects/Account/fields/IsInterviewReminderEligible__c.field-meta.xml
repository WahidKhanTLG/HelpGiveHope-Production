<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsInterviewReminderEligible__c</fullName>
    <formula>AND(
    NOT(ISBLANK(Interview_Date__c)),
    Interview_Date__c = TODAY() + 1
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>IsInterviewReminderEligible</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
