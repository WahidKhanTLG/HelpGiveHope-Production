<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>66.0</apiVersion>

    <isExposed>true</isExposed>

    <masterLabel>
        Bulk Wishlist Email Screen
    </masterLabel>

    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>

        <targetConfig targets="lightning__FlowScreen">

            <property
                name="mode"
                type="String"
                label="Screen Mode"
                description="confirm, success, or error"
                role="inputOnly"/>

            <property
                name="message"
                type="String"
                label="Message"
                role="inputOnly"/>

        </targetConfig>

    </targetConfigs>

</LightningComponentBundle>