<apex:page controller="ThankYouPageController"
    showHeader="false"
    sidebar="false"
    standardStylesheets="false"
    applyHtmlTag="false"
    applyBodyTag="false"
    docType="html-5.0"
    action="{!verify}"
>
<html>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{!title}</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #eef3f3;
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .page-wrapper {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            background: #dceaea;
            border-radius: 8px;
            padding: 40px 16px;
            position: relative;
            overflow: hidden;
        }

        .page-wrapper::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(#9fd3d0 1px, transparent 1px);
            background-size: 36px 36px;
            opacity: 0.25;
            pointer-events: none;
        }

        .thankyou-card {
            position: relative;
            z-index: 2;
            max-width: 760px;
            margin: 0 auto;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.10);
            color: #ffffff;
        }

        .thankyou-card.success {
            background: linear-gradient(135deg, #10a6a1 0%, #006d69 100%);
        }

        .thankyou-card.info {
            background: linear-gradient(135deg, #1771a6 0%, #0f4f75 100%);
        }

        .thankyou-card.warning {
            background: linear-gradient(135deg, #c07b16 0%, #8b4e00 100%);
        }

        .thankyou-card::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            top: -70px;
            right: -70px;
        }

        .thankyou-card::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
            bottom: -70px;
            left: -50px;
        }

        .card-content {
            position: relative;
            z-index: 3;
            padding: 32px 28px 28px;
            text-align: center;
        }

        .logo {
            margin-bottom: 18px;
        }

        .logo img {
            max-width: 120px;
            height: auto;
        }

        .icon-wrap {
            width: 64px;
            height: 64px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            font-weight: bold;
        }

        .title {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: 0.4px;
        }

        .subtitle {
            font-size: 17px;
            font-style: italic;
            color: #dff8f6;
            margin-bottom: 16px;
        }

        .message {
            max-width: 520px;
            margin: 0 auto 20px;
            font-size: 15px;
            line-height: 1.6;
            color: #f4ffff;
        }

        .status-box {
            max-width: 560px;
            margin: 0 auto 20px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 12px;
            padding: 14px 16px;
            font-size: 14px;
            line-height: 1.5;
        }

        .footer-text {
            margin-top: 18px;
            font-size: 12px;
            color: #d7f4f1;
        }

        @media (max-width: 768px) {
            body {
                padding: 12px;
                align-items: center;
            }

            .thankyou-card {
                max-width: 100%;
            }

            .card-content {
                padding: 24px 18px 22px;
            }

            .logo img {
                max-width: 100px;
            }

            .title {
                font-size: 24px;
            }

            .subtitle {
                font-size: 15px;
            }

            .message,
            .status-box {
                font-size: 13px;
            }
        }
    </style>
</head>

<body>
    <div class="page-wrapper">
        <div class="thankyou-card {!cardVariantClass}">
            <div class="card-content">
                <div class="logo">
                    <img src="{!URLFOR($Resource.Logo)}" alt="Help Give Hope Logo"/>
                </div>

                <div class="icon-wrap">{!iconText}</div>

                <div class="title">{!title}</div>

                <div class="subtitle">
                    {!subtitle}
                </div>

                <div class="message">
                    {!message}
                </div>

                <div class="status-box">
                    {!statusBoxMessage}
                </div>

                <div class="footer-text">
                    {!footerText}
                </div>
            </div>
        </div>
    </div>
</body>
</html>
</apex:page>