<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Manual_Override</name>
        <label>Check Manual Override</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Override_Flag</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Manual Override</defaultConnectorLabel>
        <rules>
            <name>Positive_Recommendation_Changed_To_No</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.HGH_Approval__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.HGH_Approval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Strongly Recommend</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Recommend</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Neutral</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Reviewer_Override</targetReference>
            </connector>
            <label>Positive Recommendation Changed to No</label>
        </rules>
        <rules>
            <name>Negative_Recommendation_Changed_To_Yes</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.HGH_Approval__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.HGH_Approval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Concerns</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Do Not Recommend</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Reviewer_Override</targetReference>
            </connector>
            <label>Negative Recommendation Changed to Yes</label>
        </rules>
        <rules>
            <name>Override_Flag_Enabled_Explicitly</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.HGH_Approval_Overridden__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.HGH_Approval_Overridden__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Reviewer_Override</targetReference>
            </connector>
            <label>Override Flag Enabled Explicitly</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Override_Flag</name>
        <label>Check Override Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Determine_Default_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Overridden</defaultConnectorLabel>
        <rules>
            <name>Already_Overridden</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.HGH_Approval_Overridden__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Already Overridden</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Default_Approval</name>
        <label>Determine Default Approval</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Recommendation</defaultConnectorLabel>
        <rules>
            <name>Recommendation_Approves</name>
            <conditionLogic>1 OR 2 OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Strongly Recommend</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Recommend</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Neutral</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Default_Approval_Yes</targetReference>
            </connector>
            <label>Recommendation Approves</label>
        </rules>
        <rules>
            <name>Recommendation_Does_Not_Approve</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Concerns</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Volunteer_Recommendation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Do Not Recommend</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Default_Approval_No</targetReference>
            </connector>
            <label>Recommendation Does Not Approve</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>HGH Set Preliminary Item Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HGH Set Preliminary Item Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Mark_Reviewer_Override</name>
        <label>Mark Reviewer Override</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>HGH_Approval_Overridden__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>HGH_Approval_Reviewed_By__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>HGH_Approval_Reviewed_On__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Default_Approval_No</name>
        <label>Set Default Approval No</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>HGH_Approval__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Default_Approval_Yes</name>
        <label>Set Default Approval Yes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>HGH_Approval__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Manual_Override</targetReference>
        </connector>
        <object>pmdm__ServiceDelivery__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
