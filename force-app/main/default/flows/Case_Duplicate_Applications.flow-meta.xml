<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>This Case shares the current Case&apos;s Record Type plus assistance-type combination. Counting these tells us whether the Case being viewed is part of a repeated group or stands alone.</description>
        <name>Count_Current_Key_Match</name>
        <label>Count Current Key Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCurrentKeyMatchCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Key_Seen</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>This Case repeats a Record Type plus assistance-type combination already seen on the Account, so it is a duplicate. Count it and add it to the list shown on screen.</description>
        <name>Mark_As_Duplicate</name>
        <label>Mark As Duplicate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varDuplicateCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varDuplicateCases</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Account_Cases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Account_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>First time this Record Type plus assistance-type combination has been seen on the Account, so this Case is the original. Remember the key so later Cases with the same key are flagged.</description>
        <name>Record_Key_As_Seen</name>
        <label>Record Key As Seen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSeenKeys</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fmlCaseKey</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Account_Cases</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>A Case with no Account cannot be compared against sibling applications.</description>
        <name>Check_Account_Exists</name>
        <label>Account Linked?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_No_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Account</defaultConnectorLabel>
        <rules>
            <name>Has_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_Case.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Cases</targetReference>
            </connector>
            <label>Account Linked</label>
        </rules>
    </decisions>
    <decisions>
        <description>The Account-wide duplicate count is only shown when the Case being viewed belongs to a repeated group. A match count above one means at least one other application on the Account shares this Case&apos;s Record Type plus assistance-type combination.</description>
        <name>Check_Duplicates_Found</name>
        <label>Duplicates Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_No_Duplicates</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Duplicates</defaultConnectorLabel>
        <rules>
            <name>Duplicates_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCurrentKeyMatchCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Duplicate_Count</targetReference>
            </connector>
            <label>Duplicates Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Compares the looped Case against the Case the user is viewing. Only Cases in the same Record Type plus assistance-type group are counted, so a Case that stands alone reports no duplicates even when the Account has duplicates elsewhere.</description>
        <name>Check_Is_Current_Key</name>
        <label>Same Group As Current Case?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Key_Seen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Different Group</defaultConnectorLabel>
        <rules>
            <name>Is_Current_Key</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fmlCaseKey</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>fmlCurrentCaseKey</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count_Current_Key_Match</targetReference>
            </connector>
            <label>Same Group</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether this Case key has already appeared on the Account. Because the Cases are read newest first, the first Case of each key is the original and every later one is a duplicate.</description>
        <name>Check_Key_Seen</name>
        <label>Key Already Seen?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Record_Key_As_Seen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>First Of Its Kind</defaultConnectorLabel>
        <rules>
            <name>Already_Seen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSeenKeys</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>fmlCaseKey</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_As_Duplicate</targetReference>
            </connector>
            <label>Already Seen</label>
        </rules>
    </decisions>
    <description>Read-only screen flow for the Case record page. Groups every Case on the Account by Record Type plus assistance-type checkboxes. Within each group the newest Case is the original and every extra one is a duplicate. The result is only shown when the Case being viewed belongs to a repeated group; a Case that is the only one of its kind reports no duplicates even if the Account has duplicates in other groups. When shown, the count and the data table cover every duplicate on the Account. Takes no user input and writes no data.</description>
    <environments>Default</environments>
    <formulas>
        <description>Grouping key for the Case currently being looped: Record Type plus the seven assistance checkboxes as a bit string, wrapped in pipes so it can be matched safely inside varSeenKeys.</description>
        <name>fmlCaseKey</name>
        <dataType>String</dataType>
        <expression>&quot;|&quot; &amp; {!Loop_Account_Cases.RecordTypeId} &amp; &quot;_&quot; &amp;
IF({!Loop_Account_Cases.TLG_Christmas_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Loop_Account_Cases.TLG_Rent_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Loop_Account_Cases.TLG_Used_Car_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Loop_Account_Cases.TLG_Utility_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Loop_Account_Cases.TLG_Repair_Car_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Loop_Account_Cases.TLG_Educational_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Loop_Account_Cases.TLG_Other_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp; &quot;|&quot;</expression>
    </formulas>
    <formulas>
        <description>Grouping key for the Case the user is viewing, built exactly like fmlCaseKey so the two can be compared directly.</description>
        <name>fmlCurrentCaseKey</name>
        <dataType>String</dataType>
        <expression>&quot;|&quot; &amp; {!Get_Current_Case.RecordTypeId} &amp; &quot;_&quot; &amp;
IF({!Get_Current_Case.TLG_Christmas_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Get_Current_Case.TLG_Rent_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Get_Current_Case.TLG_Used_Car_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Get_Current_Case.TLG_Utility_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Get_Current_Case.TLG_Repair_Car_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Get_Current_Case.TLG_Educational_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp;
IF({!Get_Current_Case.TLG_Other_Assistance__c}, &quot;1&quot;, &quot;0&quot;) &amp; &quot;|&quot;</expression>
    </formulas>
    <interviewLabel># of Duplicate Applications {!$Flow.CurrentDateTime}</interviewLabel>
    <label># of Duplicate Applications</label>
    <loops>
        <description>Walks every Case on the Account, newest first, so each Record Type plus assistance-type combination keeps its most recent Case as the original.</description>
        <name>Loop_Account_Cases</name>
        <label>Loop Account Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varAllAccountCases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Is_Current_Key</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Duplicates_Found</targetReference>
        </noMoreValuesConnector>
    </loops>
