<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Account</name>
        <label>Has Account?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Account_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Account</defaultConnectorLabel>
        <rules>
            <name>Account_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>Account Found</label>
        </rules>
    </decisions>
    <description>Displays household-level financial snapshot on a Case record page. Fully editable in Flow Builder — no code required to update fields or colors.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmNetBalance</name>
        <dataType>Currency</dataType>
        <expression>NULLVALUE({!varTotalIncome}, 0) - NULLVALUE({!varTotalExpenses}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>frmNetIsPositive</name>
        <dataType>Boolean</dataType>
        <expression>NULLVALUE({!varTotalIncome}, 0) &gt;= NULLVALUE({!varTotalExpenses}, 0)</expression>
    </formulas>
    <interviewLabel>Household Financial Snapshot {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Household Financial Snapshot</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Snapshot_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAccountId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputAssignments>
            <assignToReference>varBillingCity</assignToReference>
            <field>BillingCity</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varBillingState</assignToReference>
            <field>BillingState</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varHouseholdName</assignToReference>
            <field>Name</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varPhone</assignToReference>
            <field>Phone</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varShutoffNotice</assignToReference>
            <field>TLG_Do_you_have_a_shutoff_notice__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varOACACDetermination</assignToReference>
            <field>TLG_Has_OACAC_made_a_determination__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varReachedOACAC</assignToReference>
            <field>TLG_Have_you_reached_out_to_OACAC__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varZone</assignToReference>
            <field>Zone__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varMemberCount</assignToReference>
            <field>npsp__Number_of_Household_Members__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Case</name>
        <label>Get Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Case</object>
        <outputAssignments>
            <assignToReference>varAccountId</assignToReference>
            <field>AccountId</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varTotalIncome</assignToReference>
            <field>TLG_Total_Household_Income__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varTotalExpenses</assignToReference>
            <field>Total_Household_Expense__c</field>
        </outputAssignments>
    </recordLookups>
    <screens>
        <name>No_Account_Screen</name>
        <label>No Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_No_Account</name>
            <fieldText>&lt;p style=&quot;color: rgb(80, 80, 80); font-style: italic;&quot;&gt;No household account linked to this case.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Snapshot_Screen</name>
        <label>Household Financial Snapshot</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Household_Header</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 15px; color: rgb(1, 118, 211);&quot;&gt;🏠 {!varHouseholdName}&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;font-size: 12px; color: rgb(80, 80, 80);&quot;&gt;📞 {!varPhone}&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;📍 {!varBillingCity}, {!varBillingState}&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;👥 Members: &lt;strong&gt;{!varMemberCount}&lt;/strong&gt;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;Zone: &lt;strong&gt;{!varZone}&lt;/strong&gt;&lt;/p&gt;&lt;hr/&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Display_Income</name>
            <fieldText>&lt;p style=&quot;margin-bottom: 4px;&quot;&gt;&lt;span style=&quot;font-size: 13px; color: rgb(80, 80, 80);&quot;&gt;💰 Total Household Income&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;strong style=&quot;font-size: 17px; color: rgb(46, 132, 74);&quot;&gt;{!varTotalIncome}&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Display_Expenses</name>
            <fieldText>&lt;p style=&quot;margin-bottom: 4px;&quot;&gt;&lt;span style=&quot;font-size: 13px; color: rgb(80, 80, 80);&quot;&gt;💸 Total Household Expenses&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;strong style=&quot;font-size: 17px; color: rgb(186, 5, 23);&quot;&gt;{!varTotalExpenses}&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Display_Net_Positive</name>
            <fieldText>&lt;p style=&quot;background-color: rgb(235, 249, 238); border-left: 4px solid rgb(46, 132, 74); padding: 8px 12px; border-radius: 4px; margin-top: 6px;&quot;&gt;&lt;strong style=&quot;color: rgb(46, 132, 74); font-size: 15px;&quot;&gt;✅ Net Balance: {!frmNetBalance}&lt;/strong&gt;&lt;br/&gt;&lt;span style=&quot;color: rgb(46, 132, 74); font-size: 12px;&quot;&gt;Household is within budget&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>frmNetIsPositive</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Display_Net_Negative</name>
            <fieldText>&lt;p style=&quot;background-color: rgb(254, 236, 236); border-left: 4px solid rgb(186, 5, 23); padding: 8px 12px; border-radius: 4px; margin-top: 6px;&quot;&gt;&lt;strong style=&quot;color: rgb(186, 5, 23); font-size: 15px;&quot;&gt;⚠️ Net Balance: {!frmNetBalance}&lt;/strong&gt;&lt;br/&gt;&lt;span style=&quot;color: rgb(186, 5, 23); font-size: 12px;&quot;&gt;Expenses exceed income&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>frmNetIsPositive</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Display_Shutoff_Warning</name>
            <fieldText>&lt;p style=&quot;background-color: rgb(186, 5, 23); padding: 6px 14px; border-radius: 4px; margin-top: 8px; display: inline-block;&quot;&gt;&lt;strong style=&quot;color: white; font-size: 13px;&quot;&gt;⚡ SHUTOFF NOTICE ON FILE&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>varShutoffNotice</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Yes</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Display_OACAC</name>
            <fieldText>&lt;p style=&quot;margin-top: 8px; font-size: 12px; color: rgb(80, 80, 80); border-top: 1px solid rgb(230, 230, 230); padding-top: 6px;&quot;&gt;OACAC Reached: &lt;strong&gt;{!varReachedOACAC}&lt;/strong&gt;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;Determination: &lt;strong&gt;{!varOACACDetermination}&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Case</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varBillingCity</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varBillingState</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varHouseholdName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varMemberCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varOACACDetermination</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varPhone</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varReachedOACAC</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varShutoffNotice</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varTotalExpenses</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varTotalIncome</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varZone</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
