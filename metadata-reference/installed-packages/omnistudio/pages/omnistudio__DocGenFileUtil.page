<apex:page showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           docType="html-5.0"
           applyBodyTag="false"
           lightningStylesheets="false"
           applyHtmlTag="false"
           cache="false"
           controller="omnistudio.AccessTokenController">

    <html lang="en">

    <head>
        <meta http-equiv="x-ua-compatible"
              content="ie=edge" />
        <meta name="viewport"
              content="width=device-width, initial-scale=1" />
        <script src="{!URLFOR($Resource.jsforce_1_7, '/jsforce-core.min.js')}"></script>

        <apex:includeLightning />
    </head>

    <body>
        <p id="operation-message"></p>

        <script type="text/javascript">
            let url = location.href.split('/apex/');
            window.conn = new jsforce.Connection({ accessToken: '{!vlocAccessToken}', version: '37.0', instanceUrl : url[0]});
            console.log('docgenFileUtilVF initialized:'+url[0]);
            const POST_MESSAGE_KEY = '{!JSENCODE($CurrentPage.parameters.postmessagekey)}';
            const messageEl = document.getElementById('operation-message');
            const GET_CONTENT_VERSION_OPERATION = 'GET_CONTENT_VERSION';
            const SAVE_CONTENT_VERSION_OPERATION = 'SAVE_CONTENT_VERSION';

            window.addEventListener("message", (event) => {
                console.log('docgenFileUtilVF event.origin:'+ event.origin);
                if (event.data.key === POST_MESSAGE_KEY) {
                    if(event.data.operation === GET_CONTENT_VERSION_OPERATION) {
                        startGetContentVersionViaJSForce(event.data);
                    } else if (event.data.operation === SAVE_CONTENT_VERSION_OPERATION) {
                        startSaveContentVersionViaJSForce(event.data);
                    } else {
                        console.error('DocGenFileUtil: Invalid operation:'+event.data.operation);
                    }
                }
            });

            // Handshake: signal parent LWC that message listener is registered and ready.
            // This prevents race conditions caused by LWS src pre-flight (core 264+) which
            // can clear/rewrite same-origin iframe src, causing the parent to send postMessages
            // before this page's listener is active. The parent waits for this VF_READY signal
            // before sending any operations.
            window.parent.postMessage({
                key: POST_MESSAGE_KEY,
                operation: 'VF_READY'
            }, '*');

            function startGetContentVersionViaJSForce(data){
                // Validate fetch payload to be string only
                if (!data.payload || typeof data.payload !== 'string') {
                    console.error('Payload must be a non-empty string. Payload: '+ data.payload);
                    return;
                }
                
                // Ensure payload is a valid ContentVersion ID
                // ContentVersion IDs start with "068" and are 15 or 18 character alphanumeric strings
                const contentVersionIdPattern = /^068[a-zA-Z0-9]{12,15}$/;
                if (!contentVersionIdPattern.test(data.payload)) {
                    console.error('Invalid payload: payload must be a valid ContentVersion ID');
                    return;
                }
                
                window.conn.sobject('ContentVersion').retrieve(data.payload, function(err, response) {
                    let CV = response;
                    if(Array.isArray(response)) { //response sometimes returns an array
                        CV = response[0];
                    }
                    if (err) {
                        console.error('DocGenFileUtil: Failed to get content version');
                        console.error(err);
                    }

                    let url = CV.VersionData;
                    getBase64FromUrl(url).then(base64Data => {
                        CV.VersionData = base64Data;
                        postBackResponse(data.operation, CV);
                    }).catch(error => {
                        console.error(error);
                    });
                });
            }

            function startSaveContentVersionViaJSForce(data) {
                // Validate payload structure
                if (!data.payload || typeof data.payload !== 'object') {
                    console.error('Invalid payload: payload must be an object');
                    return;
                }
                
                // Validate ContentVersion specific fields and prevent injection of malicious properties
                const allowedFields = ['Title', 'PathOnClient', 'VersionData'];
                const sanitizedPayload = {};
                for (const field of allowedFields) {
                    if (data.payload.hasOwnProperty(field)) {
                        sanitizedPayload[field] = data.payload[field];
                    }
                }
                
                // proceed with sanitised payload
                window.conn.sobject('ContentVersion').create(sanitizedPayload, function(err, ret) {
                    if (err || !ret.success) {
                        console.error('DocGenFileUtil: Failed to save content version');
                        console.error(err);
                    }
                    postBackResponse(data.operation, ret);
                });
            }


            function postBackResponse(operation, responseData, error) {
                window.parent.postMessage({
                    key: POST_MESSAGE_KEY,
                    operation: operation,
                    response: responseData,
                    error: error
                }, '*');
            }

            async function getBase64FromUrl(url){
                const data = await fetch(url, {"headers": {
                    "Authorization" : "Bearer " + '{!vlocAccessToken}'
                }});
                const blob = await data.blob();
                return new Promise((resolve) => {
                    const reader = new FileReader();
                    reader.readAsDataURL(blob); 
                    reader.onloadend = function() {
                        const base64data = reader.result;   
                        resolve(base64data.split(",")[1]);
                    }
                });
            }
        </script>
    </body>

    </html>
</apex:page>